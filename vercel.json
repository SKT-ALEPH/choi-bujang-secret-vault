{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/my/notes",
      "destination": "/api/my/notes"
    },
    {
      "source": "/api/notes/:id",
      "destination": "/api/notes?id=:id"
    },
    {
      "source": "/api/announcements/:id",
      "destination": "/api/announcements?id=:id"
    },
    {
      "source": "/notes/:id",
      "destination": "/api/notes?id=:id"
    },
    {
      "source": "/notes",
      "destination": "/api/notes"
    },
    {
      "source": "/announcements/:id",
      "destination": "/api/announcements?id=:id"
    },
    {
      "source": "/announcements",
      "destination": "/api/announcements"
    }
  ]
}
